{
  "name": "@party/ui",
  "version": "0.1.0",
  "description": "Shared design system for @party/host and @party/mobile — tokens, components, synthesized sounds. Consumed as source by Vite.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc --noEmit -w -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
